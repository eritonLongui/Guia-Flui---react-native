# Copie este arquivo para .env (não commite o .env).
# Quem já está no projeto Expo pode puxar os valores com:
#   npx eas-cli env:pull --environment preview
#
# Para o APK de testers, as mesmas variáveis precisam existir no EAS
# (ambiente preview). Ver docs/SETUP.md → “Distribuir para outras pessoas”.

# Google Maps — Maps SDK for Android + iOS (+ Directions API, se quiser rota Google)
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Supabase (Settings → API no dashboard, ou `npx supabase projects api-keys --project-ref <ref>`)
# Use o mesmo projeto do time — não crie um banco novo por pessoa.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag: confirmação de email no cadastro.
# false (padrão) = entra na hora. Tem que estar desligado no Supabase:
# Authentication → Providers → Email → Confirm email.
# true = o app pede o link de confirmação; ligue Confirm email no dashboard também.
EXPO_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# Assistente de voz no mapa (padrão: ligado). Não coloque a chave OpenAI aqui —
# ela fica só no Supabase: `npx supabase secrets set OPENAI_API_KEY=...`
# EXPO_PUBLIC_ASSISTENTE_VOZ=true

# Dashboard admin (pasta admin/.env.local): use os mesmos valores acima
# com os nomes NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Ver admin/README.md.
